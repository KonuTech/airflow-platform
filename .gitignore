
# GSD research search cache (ephemeral)
.planning/research/.cache/

# QUAL-08 / ROADMAP criterion 2: the CSV corpus is generated from a committed
# seed, never committed. The manifest is the specification and CORPUS.sha256 is
# the oracle; both stay tracked.
tests/fixtures/csv/
!tests/fixtures/corpus.yaml
!tests/fixtures/CORPUS.sha256

# Environment and downloaded tooling
.venv/
tools/bin/

# D-04: scripts/cluster-rebuild.sh's last-run per-stage timing breakdown —
# a record of one run, not a build artifact anyone commits.
build/

# GSD run-scoped dispatch sentinel (WINDOWS #7) — must be ignored before any
# infrastructure file lands, or it is swept into this phase's first commit.
.gsd/

# D-02 (plan 05-01): the FIRST time this repository stores a credential-
# shaped value on the local filesystem -- every prior credential script
# (minio-credentials.sh, airflow-metadata-secret.sh, etl-secrets.sh)
# explicitly states the opposite invariant (materialize only inside the
# cluster, never on disk). This is a deliberate, narrow exception: Vault
# reveals its unseal key and root token exactly once, at `sys.initialize()`
# time, and D-02 requires a scripted, single-command unseal for a WSL2
# environment where a cluster restart is an everyday event. Written only by
# scripts/vault-unseal.py, mode 0600, never committed.
.secrets/

# Tool caches and coverage output
.mypy_cache/
.pytest_cache/
.ruff_cache/
.import_linter_cache/
__pycache__/
.coverage
.coverage.*
