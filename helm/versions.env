# Single source of every chart, tool and image version pin for Phase 2.
#
# This is the ONLY place a version literal for these artifacts may live.
# `tests/policy/test_pinned_tool_versions_agree.py` enforces agreement between
# this file and every other place a reader might expect the same number
# (installer scripts, the Makefile, values files) — the same shape as Phase
# 1's `UV_REQUIRED_VERSION` / gitleaks-version enforcement, generalised to
# infrastructure tooling and Helm charts.
#
# `KEY=value` lines only, no quoting, no inline comments — sourceable by
# `scripts/*.sh` via `source helm/versions.env` and readable by the policy
# test via a plain `KEY=value` regex.

KIND_VERSION=0.32.0
KIND_NODE_IMAGE=kindest/node:v1.35.5@sha256:ce977ae6d65918d0b58a5f8b5e940429c2ce42fa3a5619ec2bbc60b949c0ac95
HELM_VERSION=4.2.3
KUBECONFORM_VERSION=0.8.0
KUBERNETES_VERSION=1.35.5

INGRESS_NGINX_CHART_VERSION=4.15.1
CNPG_OPERATOR_CHART_VERSION=0.29.0
CNPG_CLUSTER_CHART_VERSION=0.8.1
MINIO_CHART_VERSION=5.4.0
MINIO_IMAGE_TAG=RELEASE.2026-08-04T00-00-00Z
AIRFLOW_CHART_VERSION=1.22.0
# plan 07-04: the custom apache-airflow[otel] image (docker/airflow/
# Dockerfile), tagged by the git SHA of the commit that introduced it -- kept
# in agreement with helm/values/{local,ci}/airflow.yaml's own
# defaultAirflowTag by tests/policy/test_supply_chain_guards.py's
# test_every_image_tag_agrees_with_versions_env. Built and pushed via
# `make image-airflow` against the local registry (orchestrator follow-up
# to 07-04-SUMMARY.md's Deviations section, since that worktree agent had
# no docker/kubectl access).
AIRFLOW_IMAGE_TAG=7403b96
VAULT_CHART_VERSION=0.34.0

OTEL_COLLECTOR_CHART_VERSION=0.169.0

# Plan 07-03: resolved empirically via `helm search repo tempo` against both
# candidate repos (RESEARCH.md Assumption A4). `grafana-community/tempo`
# (chart 2.2.4 / appVersion 2.10.8) is the actively-maintained repo -- the
# same `grafana-community.github.io/helm-charts` move already documented for
# the Grafana dashboard subchart in `.claude/CLAUDE.md` Section H. The legacy
# `grafana/tempo` repo still resolves but is stuck at chart 1.24.4 / appVersion
# 2.9.0, confirming it is the stale mirror, not the canonical source.
TEMPO_CHART_VERSION=2.2.4

REGISTRY_IMAGE=registry:3
REGISTRY_PORT=5001
CLUSTER_NAME=airflow-platform
